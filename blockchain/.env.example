# Copy to .env. The actual signing key lives encrypted in
# ~/.foundry/keystores/monad-deployer (via `cast wallet import`) —
# never in this file. DEPLOYER_ADDRESS is public, fine to share;
# KEYSTORE_PASSWORD is not.

DEPLOYER_ADDRESS=
KEYSTORE_PASSWORD=
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Alchemy RPC endpoint (preferred over the public RPC above — used by
# foundry.toml's eth-rpc-url via ${ALCHEMY_RPC_URL} interpolation).
# Get one at https://dashboard.alchemy.com/ (Monad Testnet app).
ALCHEMY_RPC_URL=
