# Copy to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string (Neon)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ptfdwpzybwvocdiwsihd.supabase.co:5432/postgres

# Signing key for session cookies — any long random string, e.g. `openssl rand -hex 32`
AUTH_SECRET=

# Resend
RESEND_API_KEY=
# Optional — defaults to Resend's shared test sender if unset
RESEND_FROM_EMAIL="The Artisans <onboarding@resend.dev>"

# Used to build links inside emails (verification link, etc.)
APP_URL=http://localhost:3000
